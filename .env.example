# =============================================================================
# KLARA – HR Knowledge Assistant | Konfiguration
# Kopieren nach .env und Werte eintragen. Ohne Keys laeuft KLARA im
# Offline-Modus (lokale Embeddings + Template-Antworten).
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Claude API (Antwort-Synthese, Query Rewriting, RAGAS-Evaluation) -------
# Ohne Key: deterministische Template-Antworten (Demo-/Testbetrieb)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_REWRITER_MODEL=claude-haiku-4-5

# --- Embeddings (optional) ---------------------------------------------------
# Ohne Key: lokales lexikalisches Retrieval (BM25-aehnlich)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Wissensdatenbank & Audit ------------------------------------------------
KNOWLEDGE_BASE_PATH=./data/knowledge_base
AUDIT_LOG_PATH=./logs/audit.jsonl

# --- Supabase Vector Store (optional) ----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_TABLE=rag_documents
